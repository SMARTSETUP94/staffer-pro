      {
        "name": "qui_est_ou",
        "title": "Qui est où",
        "description": "Affectations par demi-journée, indisponibilités validées et anomalies ; période maximale de 93 jours.",
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
