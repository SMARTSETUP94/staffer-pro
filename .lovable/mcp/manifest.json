{
  "version": 1,
  "sdk_version": "3.3.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://znwffztmdgsshuvvzsvq.supabase.co/auth/v1",
    "require_oauth_client_claim": true,
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "project-shift",
      "version": "1.0.0",
      "title": "Project Shift"
    },
    "tools": [
      {
        "name": "rechercher_affaires",
        "title": "Rechercher les affaires",
        "description": "Rechercher les chantiers autorisés par numéro, nom, typologie, statut et dates de montage.",
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "q": {
              "type": "string",
              "maxLength": 120
            },
            "typologie": {
              "type": "string",
              "enum": [
                "fabrication",
                "montage_demontage",
                "stockage",
                "prototype",
                "non_operationnel"
              ]
            },
            "statut": {
              "type": "string",
              "maxLength": 40
            },
            "montage_du": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "montage_au": {
              "$ref": "#/properties/montage_du"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            },
            "cursor": {
              "type": "string",
              "pattern": "^\\d{1,8}$",
              "default": "0"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "fiche_affaire",
        "title": "Consulter une affaire",
        "description": "Identité, dates, équipe, objets et devis autorisés ; aucun salaire individuel.",
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "affaire_id": {
              "type": "string",
              "format": "uuid"
            },
            "numero": {
              "type": "string",
              "pattern": "^\\d{4,5}$"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            },
            "cursor": {
              "type": "string",
              "pattern": "^\\d{1,8}$",
              "default": "0"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
